rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function validKey(k) {
      return k in ['C','C#','D','Eb','E','F','F#','G','Ab','A','Bb','B'];
    }

    function validSongShape() {
      return request.resource.data.title is string
        && request.resource.data.originalKey is string
        && validKey(request.resource.data.originalKey)
        && request.resource.data.sections is list
        && request.resource.data.status in ['active', 'archived'];
    }

    match /songs/{songId} {
      allow read: if resource.data.status == 'active';

      allow create: if isAdmin() && validSongShape();
      allow update: if isAdmin() && validSongShape();
      allow delete: if isAdmin();
    }

    match /songIndex/{chunkId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.entries is list
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /songEdits/{editId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.songId is string
        && request.resource.data.status in ['draft', 'archived']
        && request.resource.data.baseVersion is int;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    function playlistOwnerId(data) {
      return data.ownerId != null ? data.ownerId : data.createdBy;
    }

    function isGroupMember(groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return request.auth.uid in group.memberIds;
    }

    function isGroupJoinUpdate() {
      return isAuth()
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.name == resource.data.name;
    }

    function canReadPlaylist(sessionId) {
      let playlist = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      return isAuth() && (
        playlist.status == 'published'
        || playlistOwnerId(playlist) == request.auth.uid
        || request.auth.uid in playlist.get('sharedWith', [])
        || (playlist.get('groupId', null) != null
            && isGroupMember(playlist.groupId))
        || isAdmin()
      );
    }

    function isPlaylistOwner(sessionId) {
      let playlist = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      return isAuth() && playlistOwnerId(playlist) == request.auth.uid;
    }

    function validPlaylistCreate() {
      return request.resource.data.title is string
        && request.resource.data.date is timestamp
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sharedWith is list
        && request.resource.data.status in ['draft', 'published'];
    }

    match /sessions/{sessionId} {
      allow read: if isAuth() && (
        resource.data.status == 'published'
        || playlistOwnerId(resource.data) == request.auth.uid
        || request.auth.uid in resource.data.get('sharedWith', [])
        || (resource.data.get('groupId', null) != null
            && isGroupMember(resource.data.groupId))
        || isAdmin()
      );

      allow create: if isAuth() && validPlaylistCreate();

      allow update: if isAuth() && (
        playlistOwnerId(resource.data) == request.auth.uid
        || isAdmin()
      );

      allow delete: if isAuth() && (
        playlistOwnerId(resource.data) == request.auth.uid
        || isAdmin()
      );

      match /sessionSongs/{entryId} {
        allow read: if canReadPlaylist(sessionId);
        allow create: if isAuth() && (isPlaylistOwner(sessionId) || isAdmin())
          && request.resource.data.songId is string
          && request.resource.data.order is number;
        allow update: if isAuth() && (isPlaylistOwner(sessionId) || isAdmin());
        allow delete: if isAuth() && (isPlaylistOwner(sessionId) || isAdmin());
      }
    }

    function validUsernameFields() {
      return request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.username == request.resource.data.usernameLower
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20;
    }

    function validUserCreate() {
      return request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role == 'musician'
        && request.resource.data.avatarInitials is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastLoginAt is timestamp
        && validUsernameFields();
    }

    function validLegacyUserCreate() {
      return request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role == 'musician'
        && request.resource.data.createdAt is timestamp
        && !('username' in request.resource.data)
        && (!('lastLoginAt' in request.resource.data)
            || request.resource.data.lastLoginAt is timestamp);
    }

    match /groupInviteCodes/{code} {
      // get-only: a join requires the exact code. Listing is denied so the
      // full set of active invite codes cannot be enumerated.
      allow get: if isAuth();
      allow list: if false;
      allow create: if isAuth()
        && request.resource.data.groupId is string
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.memberIds
        || isAdmin()
      );

      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.name is string
        && request.resource.data.inviteCode is string
        && request.resource.data.memberIds is list
        && request.resource.data.members is list
        && request.resource.data.playlistCount is int;

      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid
        || isGroupJoinUpdate()
        || isAdmin()
      );

      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid
        || isAdmin()
      );
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && (validUserCreate() || validLegacyUserCreate());

      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && (!('username' in resource.data) || (
          request.resource.data.username == resource.data.username
          && request.resource.data.usernameLower == resource.data.usernameLower
        ))
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'lastLoginAt', 'avatarInitials']);

      allow delete: if false;
    }

    match /usernames/{usernameLower} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && usernameLower == request.resource.data.usernameLower
        && request.resource.data.usernameLower.size() >= 3
        && request.resource.data.usernameLower.size() <= 20
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /meta/{docId} {
      allow read: if isAuth();
      allow write: if false;
    }
  }
}
