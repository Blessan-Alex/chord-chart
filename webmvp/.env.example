# Firebase Web SDK (Firebase Console → Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only if you add Firebase Analytics later
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App Check — reCAPTCHA Enterprise site key (Firebase Console → App Check → Web app)
NEXT_PUBLIC_FIREBASE_APP_CHECK_KEY=

# Local emulator (set true when running: npx firebase emulators:start)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
